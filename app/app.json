{
  "design": "artwork",
  "id": "night-stall",
  "name": "Night Stall",
  "version": "0.4.0",
  "description": "A pixel-art noodle cart on a rainy night played like an animatronic band. Each thing in it (lamps, puddles, table, cat, sign, bulbs, steam, bubbles, weather) is a performer you can link to a track of the song, to the beat, bar or section, to another performer, or to a control track you record by tapping along, or leave free. A built-in MIDI player, MIDI files and pre-analysed audio files give it the whole score in advance; Radio, a microphone, a DAW through the sys0 Bridge or external cues drive it live.",
  "icon": "a red-and-cream striped awning over a teal noodle cart glowing orange in the rain",
  "multiple": false,
  "personal": true,
  "initialSize": {
    "w": 1120,
    "h": 640
  },
